<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>US-03: Record-Triggered Flow (after-save). Dispara SOMENTE quando Status__c passa a Pendente. Aprovacao automatica (0-5%) ou roteamento ao aprovador do nivel (matriz em Custom Metadata) com Task idempotente (chave id+ciclo). Nao recalcula valores: isso e responsabilidade da Trigger.</description>
    <environments>Default</environments>
    <interviewLabel>Negociacao Roteamento Aprovacao {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Negociacao - Roteamento de Aprovacao</label>
    <actionCalls>
        <name>Aprovar_Automaticamente</name>
        <label>Aprovar automaticamente (0% a 5%)</label>
        <locationX>50</locationX>
        <locationY>566</locationY>
        <actionName>TrainingApprovalRoutingAction</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>autoApprove</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>negotiationId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>nivel</name>
            <value>
                <elementReference>$Record.Nivel_Aprovacao__c</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>Rotear_Humano</name>
        <label>Resolver aprovador do nivel</label>
        <locationX>314</locationX>
        <locationY>890</locationY>
        <actionName>TrainingApprovalRoutingAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Criar_Tarefa_Aprovacao</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>autoApprove</name>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>negotiationId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>nivel</name>
            <value>
                <elementReference>$Record.Nivel_Aprovacao__c</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <decisions>
        <name>Config_Existe</name>
        <label>Configuracao do nivel existe?</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Sem configuracao</defaultConnectorLabel>
        <rules>
            <name>Config_Encontrada</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Config_Nivel</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Tipo_Aprovacao</targetReference>
            </connector>
            <label>Configuracao encontrada</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tipo_Aprovacao</name>
        <label>Aprovacao automatica?</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Get_Tarefa_Existente</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Aprovador humano</defaultConnectorLabel>
        <rules>
            <name>Eh_Automatica</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Config_Nivel.Aprovacao_Automatica__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Aprovar_Automaticamente</targetReference>
            </connector>
            <label>Automatica</label>
        </rules>
    </decisions>
    <decisions>
        <name>Tarefa_Ja_Existe</name>
        <label>Tarefa do ciclo ja existe?</label>
        <locationX>314</locationX>
        <locationY>782</locationY>
        <defaultConnectorLabel>Tarefa ja existe (reprocessamento)</defaultConnectorLabel>
        <rules>
            <name>Tarefa_Nao_Existe</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Tarefa_Existente</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Rotear_Humano</targetReference>
            </connector>
            <label>Tarefa nao existe</label>
        </rules>
    </decisions>
    <formulas>
        <name>Chave_Idempotencia</name>
        <dataType>String</dataType>
        <expression>{!$Record.Id} &amp; &quot;-&quot; &amp; TEXT({!$Record.Ciclo_Aprovacao__c})</expression>
    </formulas>
    <formulas>
        <name>Assunto_Tarefa</name>
        <dataType>String</dataType>
        <expression>&quot;Aprovar negociacao &quot; &amp; {!$Record.Name} &amp; &quot; (ciclo &quot; &amp; TEXT({!$Record.Ciclo_Aprovacao__c}) &amp; &quot;)&quot;</expression>
    </formulas>
    <formulas>
        <name>Prazo_Tarefa</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 2</expression>
    </formulas>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Criar_Tarefa_Aprovacao</name>
        <label>Criar tarefa de aprovacao</label>
        <locationX>314</locationX>
        <locationY>998</locationY>
        <connector>
            <targetReference>Registrar_Aprovador_Esperado</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>Prazo_Tarefa</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Chave_Idempotencia__c</field>
            <value>
                <elementReference>Chave_Idempotencia</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Negociacao comercial aguardando decisao. Abra o registro e use a acao Decidir.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Rotear_Humano.approverId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Assunto_Tarefa</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Config_Nivel</name>
        <label>Buscar configuracao do nivel (Custom Metadata)</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Config_Existe</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Nivel__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Nivel_Aprovacao__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Aprovacao_Nivel__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Tarefa_Existente</name>
        <label>Buscar tarefa do ciclo (idempotencia)</label>
        <locationX>314</locationX>
        <locationY>674</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Tarefa_Ja_Existe</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Chave_Idempotencia__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Chave_Idempotencia</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Registrar_Aprovador_Esperado</name>
        <label>Registrar aprovador esperado</label>
        <locationX>314</locationX>
        <locationY>1106</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Aprovador__c</field>
            <value>
                <elementReference>Rotear_Humano.approverId</elementReference>
            </value>
        </inputAssignments>
        <object>Negociacao_Comercial__c</object>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Config_Nivel</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pendente</stringValue>
            </value>
        </filters>
        <object>Negociacao_Comercial__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
